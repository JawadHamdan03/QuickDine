# Copy this file to .env.docker and fill in real values before running Compose.
#   cp server/.env.docker.example server/.env.docker
#
# MONGODB_URI is overridden by docker-compose.yml to point at the "db" service,
# so you do not need to set it here for Compose. It is listed for reference /
# running the container standalone.
MONGODB_URI=mongodb://db:27017/quick-dine
JWT_SECRET=change-me-to-a-long-random-secret
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
PORT=5000
NODE_ENV=production
